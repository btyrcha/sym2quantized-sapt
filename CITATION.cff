date-released: 2023-12-10
license: BSD-3-Clause
repository-code: "https://github.com/btyrcha/sym2quantized-sapt"
url: "https://github.com/btyrcha/sym2quantized-sapt"
keywords:
  - SAPT
  - quantum chemistry
  - second quantization
  - Wick's theorem
  - SymPy
